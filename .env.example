# ── EduQuest environment ─────────────────────────────────────────────
# Copy to .env.local. Nothing here is ever sent to the browser.

# Mode: demo (default, local SQLite + demo sign-in) or production.
# Production mode also requires SUPABASE_URL and SUPABASE_ANON_KEY.
EDUQUEST_MODE=demo

# Session signing key (≥32 random chars). Required in production.
# Demo mode generates one in .data/session-secret if unset.
# SESSION_SECRET=

# ── AI ──────────────────────────────────────────────────────
# Cloud AI (fast). Set a key and the tutor and generators use it.
# Default: Groq's free tier. Get a free key (no card) at
# https://console.groq.com/keys. Keep the key out of git: put it in .env.local.
# AI_API_KEY=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
# AI_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible service works by changing the base URL + model, e.g.
# Google Gemini (free tier; Google may use free-tier prompts to improve its products):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=<a Gemini Flash model id from AI Studio>
# Optional: a smaller, faster model just for the tutor chat (stretches free limits).
# AI_CHAT_MODEL=openai/gpt-oss-20b
# Optional backup provider, used automatically when the main one is busy or down:
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_FALLBACK_MODEL=<model id>
# AI_FALLBACK_CHAT_MODEL=<optional smaller model id>
#
# Without AI_API_KEY:
# AI runs in each visitor's browser (WebLLM, Qwen3 1.7B on their GPU):
# no API key, no tokens, no cost. AI_BROWSER=off turns it off.
AI_BROWSER=on
# Devices without WebGPU fall back to clearly labelled rule-based
# simulations; AI_SIMULATION=off shows an "AI not configured" state instead.
AI_SIMULATION=on
# Per-user daily AI request ceiling (schools can lower it in settings).
AI_DAILY_REQUEST_LIMIT=60

# ── Uploads & data ──────────────────────────────────────────
MAX_UPLOAD_MB=10
# Where the database and uploads live. On a host, point this at a
# persistent disk (e.g. /data) so data survives restarts.
# EDUQUEST_DATA_DIR=./.data
# Set to off on public servers so nobody can press "Reset demo data".
# ALLOW_DEMO_RESET=off

# ── Supabase (production backend, see docs/DEPLOYMENT.md) ──────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
